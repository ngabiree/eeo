# Local prototype: no backend required. Leave unset for corridor UI only.
#
# Supabase (modern key names):
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# SUPABASE_SECRET_KEY=sb_secret_xxxxx                      # server-only; never expose to browser or commit
#
# Database connection string (use your project ref and region from the Supabase dashboard):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:<DB_PASSWORD>@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
